    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet aiResponse = '';\nif (input.output && input.output[0] && input.output[0].content && input.output[0].content[0]) {\n  aiResponse = input.output[0].content[0].text;\n} else if (input.message && input.message.content) {\n  aiResponse = input.message.content;\n} else if (input.text) {\n  aiResponse = input.text;\n} else {\n  aiResponse = JSON.stringify(input);\n}\n\nlet parsed;\ntry {\n  const cleaned = aiResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    intent: 'other',\n    sentiment: 'neutral',\n    reply: 'مرحبا! كيف أقدر أساعدك؟',\n    needs_handoff: false\n  };\n}\n\nconst msg = $('Parse Whatsapp Message').first().json;\n\nreturn [{\n  json: {\n    ...msg,\n    intent: parsed.intent || 'other',\n    sentiment: parsed.sentiment || 'neutral',\n    ai_reply: parsed.reply || 'مرحبا! كيف أقدر أساعدك؟',\n    needs_handoff: parsed.needs_handoff === true\n  }\n}];"
      },
