    {
      "parameters": {
        "jsCode": "// Incoming WhatsApp Cloud API webhook\nconst body = $input.first().json.body || {};\n\nconst value = body.entry?.[0]?.changes?.[0]?.value;\n\n// Delivery/read receipts and other events have no messages\nif (!value || !value.messages || !value.messages[0]) {\n  return [{ json: { skip: true, reason: 'no_message' } }];\n}\n\nconst message = value.messages[0];\nconst contact = value.contacts?.[0];\n\nconst messageType = message.type || 'text';\nlet messageText = message.text?.body || '';\nif (!messageText && messageType !== 'text') {\n  messageText = `[${messageType} message]`;\n}\n\nreturn [{\n  json: {\n    skip: false,\n    message_id: message.id,\n    phone_number: message.from,\n    sender_name: contact?.profile?.name || 'Unknown',\n    message_text: messageText,\n    message_type: messageType,\n    business_id: 'restaurant_demo'\n  }\n}];"
      },
